{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lyzr Registry",
  "description": "Registry of Lyzr agents and knowledge bases for the Tasco monorepo",
  "type": "object",
  "required": ["version", "agents", "knowledgeBases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date",
      "description": "Last update date"
    },
    "apiUrl": {
      "type": "string",
      "format": "uri",
      "description": "Lyzr API base URL"
    },
    "agents": {
      "type": "object",
      "description": "Agents organized by app",
      "additionalProperties": {
        "type": "object",
        "description": "Agents for a specific app",
        "additionalProperties": {
          "$ref": "#/definitions/agent"
        }
      }
    },
    "knowledgeBases": {
      "type": "object",
      "description": "Knowledge bases by key",
      "additionalProperties": {
        "$ref": "#/definitions/knowledgeBase"
      }
    },
    "documentCategories": {
      "type": "object",
      "description": "Document category definitions",
      "additionalProperties": {
        "$ref": "#/definitions/documentCategory"
      }
    },
    "scripts": {
      "type": "object",
      "description": "Available scripts per app",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "agent": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "description": "Lyzr agent ID (null if not created)"
        },
        "name": {
          "type": "string",
          "description": "Agent display name"
        },
        "role": {
          "type": "string",
          "enum": ["main", "orchestrator", "expert", "validator"],
          "description": "Agent role in the system"
        },
        "model": {
          "type": "string",
          "description": "LLM model used",
          "enum": ["gpt-4o", "gpt-4o-mini", "gpt-4-turbo", "gpt-4-turbo-preview"]
        },
        "description": {
          "type": "string",
          "description": "What this agent does"
        },
        "connectedKBs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Keys of connected knowledge bases"
        },
        "subAgents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Keys of sub-agents (for orchestrators)"
        },
        "envVar": {
          "type": "string",
          "description": "Environment variable name for this agent ID"
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending", "deprecated"],
          "description": "Agent status"
        }
      }
    },
    "knowledgeBase": {
      "type": "object",
      "required": ["name", "app"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "description": "Lyzr KB ID (null if not created)"
        },
        "name": {
          "type": "string",
          "description": "KB name in Lyzr"
        },
        "app": {
          "type": "string",
          "description": "App this KB belongs to"
        },
        "description": {
          "type": "string",
          "description": "What documents this KB contains"
        },
        "documentFilter": {
          "type": "object",
          "description": "Filter criteria for documents",
          "properties": {
            "category": { "type": "string" },
            "excludeCategory": { "type": "string" },
            "entityId": { "type": "string" }
          }
        },
        "connectedAgents": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent keys connected to this KB"
        },
        "envVar": {
          "type": "string",
          "description": "Environment variable name for this KB ID"
        },
        "documentCount": {
          "type": "integer",
          "description": "Number of documents synced"
        }
      }
    },
    "documentCategory": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string"
        },
        "entityId": {
          "type": "string",
          "description": "Default entityId for this category"
        },
        "targetKB": {
          "type": "string",
          "description": "KB key where these docs should go"
        }
      }
    }
  }
}
