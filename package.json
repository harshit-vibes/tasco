{
  "name": "tasco",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "registry": "bun scripts/registry.ts",
    "registry:list": "bun scripts/registry.ts list",
    "registry:sync": "bun scripts/registry.ts sync",
    "registry:env": "bun scripts/registry.ts env",
    "agents": "bun --cwd packages/agents",
    "agents:list": "bun --cwd packages/agents run list-agents",
    "agents:validate": "bun --cwd packages/agents run validate",
    "agents:setup": "bun --cwd packages/agents run setup-all",
    "agents:sync": "bun --cwd packages/agents run sync-registry",
    "amplify:env": "bun scripts/generate-amplify-env.ts",
    "amplify:env:json": "bun scripts/generate-amplify-env.ts --json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "mammoth": "^1.11.0",
    "next": "^15.1.3",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "bun@1.1.42"
}
