# ============================================
# TASCO MONOREPO - SHARED ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your credentials
# These variables are shared across all 8 apps via Turborepo
#
# For production, set these in AWS Amplify Console for each app

# --------------------------------------------
# LYZR API (Required - shared across all apps)
# --------------------------------------------
# Get from Lyzr Studio: https://studio.lyzr.ai
LYZR_API_KEY=
NEXT_PUBLIC_LYZR_API_KEY=
NEXT_PUBLIC_LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
NEXT_PUBLIC_RAG_URL=https://rag-prod.studio.lyzr.ai

# --------------------------------------------
# AWS DynamoDB (Required - shared across all apps)
# --------------------------------------------
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=

# --------------------------------------------
# APP-SPECIFIC AGENT IDs (from @tasco/agents registry)
# --------------------------------------------
# Note: Each app uses different agent IDs
# See: apps/<app-name>/.env.local.example for app-specific IDs
# These are pre-configured in the centralized registry

# COMPLIANCE-QA
# NEXT_PUBLIC_LYZR_AGENT_ID=696108ed5e0239738a838cd8

# E-LEARNING
# NEXT_PUBLIC_LYZR_AGENT_ID=6961ba6bd09b5523633454d5

# SALES-ORDER
# NEXT_PUBLIC_LYZR_AGENT_ID=69613126c57d451439d4c4e4

# CUSTOMER-LIFECYCLE
# NEXT_PUBLIC_LYZR_AGENT_ID=69625ab1d09b552363346dd5

# SALES-PRICING
# NEXT_PUBLIC_LYZR_AGENT_ID=69625ab2d09b552363346dd6

# RISK-RADAR
# NEXT_PUBLIC_LYZR_AGENT_ID=69625ab2d09b552363346dd7

# DATA-SYNC
# NEXT_PUBLIC_LYZR_AGENT_ID=69625ab3d09b552363346dd8

# PROMOTION-CONTROL (no chat agent)
