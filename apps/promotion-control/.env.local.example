# ============================================
# PROMOTION-CONTROL APP CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your API keys
# This app does not use chat agents (no chat feature)

# --------------------------------------------
# LYZR CONFIGURATION
# --------------------------------------------
# This app currently has no AI chat agents
# Promotion conflict detection is rule-based

# --------------------------------------------
# LYZR API KEY (optional - for future features)
# --------------------------------------------
NEXT_PUBLIC_LYZR_API_KEY=
LYZR_API_KEY=

# --------------------------------------------
# KNOWLEDGE BASE (pending - ID will be assigned)
# --------------------------------------------
# Promotions KB - Promotion rules and history
# LYZR_PROMOTIONS_KB_ID=

# --------------------------------------------
# AWS CONFIGURATION (required)
# --------------------------------------------
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
