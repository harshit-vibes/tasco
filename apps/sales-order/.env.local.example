# ============================================
# SALES-ORDER APP CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your API keys
# Agent IDs are pre-configured from @tasco/agents registry

# --------------------------------------------
# LYZR AGENT IDs (from registry)
# --------------------------------------------

# Extraction Agent - OCR data extraction from Vietnamese orders
EXTRACTION_AGENT_ID=69613126c57d451439d4c4e4

# Validation Agent - Order data validation
VALIDATION_AGENT_ID=69613126c57d451439d4c4e5

# Main Agent ID (uses extraction agent as primary)
NEXT_PUBLIC_LYZR_AGENT_ID=69613126c57d451439d4c4e4

# --------------------------------------------
# LYZR API KEY (required)
# --------------------------------------------
NEXT_PUBLIC_LYZR_API_KEY=
LYZR_API_KEY=

# --------------------------------------------
# KNOWLEDGE BASE (pending - ID will be assigned)
# --------------------------------------------
# Orders KB - Order templates and product catalog
# LYZR_ORDERS_KB_ID=

# --------------------------------------------
# AWS CONFIGURATION (required)
# --------------------------------------------
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
