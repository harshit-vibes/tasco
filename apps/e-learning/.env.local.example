# ============================================
# E-LEARNING APP CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your API keys
# Agent IDs are pre-configured from @tasco/agents registry

# --------------------------------------------
# LYZR AGENT IDs (from registry)
# --------------------------------------------

# Chat Assistant - Main learner support agent
NEXT_PUBLIC_LYZR_AGENT_ID=6961ba6bd09b5523633454d5

# Validation Agent - Response quality scoring
NEXT_PUBLIC_LYZR_VALIDATION_AGENT_ID=6961ba6bd09b5523633454d6

# Course Outline Generator - Creates course structures
LYZR_COURSE_OUTLINE_AGENT_ID=6960efc45e0239738a838056

# Module Content Generator - Creates module lessons
LYZR_MODULE_CONTENT_AGENT_ID=6960efcf5e0239738a838072

# Lesson Generator - Creates individual lessons
LYZR_LESSON_GENERATOR_AGENT_ID=6960f136c57d451439d4b4a1

# Quiz Generator - Creates quiz questions
LYZR_QUIZ_GENERATOR_AGENT_ID=6960f1445e0239738a8383b9

# --------------------------------------------
# LYZR API KEY (required)
# --------------------------------------------
NEXT_PUBLIC_LYZR_API_KEY=
LYZR_API_KEY=

# --------------------------------------------
# KNOWLEDGE BASE (pending - ID will be assigned)
# --------------------------------------------
# Courses KB - Training content and materials
# LYZR_COURSES_KB_ID=

# --------------------------------------------
# AWS CONFIGURATION (required)
# --------------------------------------------
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
