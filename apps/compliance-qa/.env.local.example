# ============================================
# COMPLIANCE-QA APP CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your API keys
# Agent IDs are pre-configured from @tasco/agents registry

# --------------------------------------------
# LYZR AGENT IDs (from registry)
# --------------------------------------------

# Orchestrator Agent - Routes queries to expert agents
NEXT_PUBLIC_LYZR_AGENT_ID=696108ed5e0239738a838cd8

# Validation Agent - Response quality scoring
NEXT_PUBLIC_LYZR_VALIDATION_AGENT_ID=696108f75e0239738a838cdf

# Legal Expert Agent - Vietnamese laws and regulations
NEXT_PUBLIC_LYZR_LEGAL_AGENT_ID=69613776c57d451439d4c8f4

# Internal Expert Agent - Company policies and charters
NEXT_PUBLIC_LYZR_INTERNAL_AGENT_ID=69613777c57d451439d4c8f5

# --------------------------------------------
# LYZR API KEY (required)
# --------------------------------------------
# Get from Lyzr Studio: https://studio.lyzr.ai
NEXT_PUBLIC_LYZR_API_KEY=

# Server-side API key (same as above, for API routes)
LYZR_API_KEY=

# --------------------------------------------
# KNOWLEDGE BASE IDs (from registry)
# --------------------------------------------

# RAG API URL
NEXT_PUBLIC_RAG_URL=https://rag-prod.studio.lyzr.ai

# Internal KB - Company policies, charters, contracts
LYZR_KB_ID=6960a63fee18986913060bc0
NEXT_PUBLIC_LYZR_KB_ID=6960a63fee18986913060bc0

# Legal KB - Vietnamese laws and regulations
LYZR_LEGAL_KB_ID=69613775979041509ac8ee82
NEXT_PUBLIC_LYZR_LEGAL_KB_ID=69613775979041509ac8ee82

# --------------------------------------------
# AWS CONFIGURATION (required)
# --------------------------------------------
# AWS credentials for DynamoDB access
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
